{
    "name": "trade-plus-extension",
    "version": "0.1.5",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:chrome": "node ./scripts/run-wxt-dev.mjs --browser chrome",
        "dev:firefox": "node ./scripts/run-wxt-dev.mjs --browser firefox",
        "dev": "npm run dev:chrome && npm run dev:firefox",
        "build": "wxt build",
        "zip:chrome": " npx wxt zip --browser chrome",
        "zip:firefox": " npx wxt zip --browser firefox",
        "zip": "npm run zip:chrome && npm run zip:firefox",
        "check": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest src",
        "test:run": "vitest run src",
        "test:e2e:zoom": "playwright test tests/e2e/zoom-override.spec.ts"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@types/chrome": "^0.1.37",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@wxt-dev/module-react": "^1.1.5",
        "prettier": "^3.8.1",
        "typescript": "^5.6.3",
        "vitest": "^3.2.4",
        "wxt": "^0.20.18"
    }
}
